# Server configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# SQLite storage path (used when DATABASE_URL is unset)
DATABASE_PATH=/data/volq.db

# Optional PostgreSQL connection string (leave blank for SQLite mode)
# Example with compose postgres profile: postgresql://volq:volq@postgres:5432/volq
DATABASE_URL=
DATABASE_SSL=false

# Generate strong random values before deploying (e.g., `openssl rand -hex 32`)
SESSION_SECRET=replace-with-long-random-session-secret
ENCRYPTION_KEY=replace-with-long-random-encryption-key

# Proxy and cookie settings (set COOKIE_SECURE=true and TRUST_PROXY=true behind HTTPS/Render)
COOKIE_SECURE=false
TRUST_PROXY=false
SERVE_WEB_DIST=false

# Maximum file upload size (MB) for Admin Knowledge Bases
MAX_UPLOAD_MB=25

# Allowed browser origin for CSRF origin checks
APP_ORIGIN=http://localhost:3000

# Public base URL used to construct OAuth redirect URIs (optional; falls back to request origin)
# Example: https://chat.example.com
APP_BASE_URL=http://localhost:3000

# Optional default Ollama URL shown as a placeholder in Admin > Connections
DEFAULT_OLLAMA_URL=http://localhost:11434
